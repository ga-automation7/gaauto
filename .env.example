# ─────────────────────────────────────────────────────────────
# GA Automations — environment variables
#
# Copy to `.env.local` and fill in. Only variables prefixed with VITE_
# are exposed to the browser bundle — NEVER put secrets in VITE_ vars.
# Server-side secrets (CRM keys, WhatsApp tokens, LLM keys) belong in the
# future backend, not here. See docs/future-backend.md.
# ─────────────────────────────────────────────────────────────

# Public site URL (canonical, OG tags)
VITE_SITE_URL=https://gaauto.in

# Public contact address shown on the site and used for the mailto fallback.
VITE_CONTACT_EMAIL=contact@gaauto.in

# Optional WhatsApp number in international format without "+" (e.g. 919876543210).
# Leave empty to hide the WhatsApp link.
VITE_WHATSAPP_NUMBER=

# Optional endpoint that accepts inquiry POSTs (JSON). When empty, the contact
# composer falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=

# Optional base URL of the future GA Automations API.
VITE_API_BASE_URL=

# Optional analytics provider key (public / browser-safe keys only).
VITE_ANALYTICS_KEY=
